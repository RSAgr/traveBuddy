# Copy these values into backend/.env for the paid-price demo.
# Use separate Algorand TestNet accounts for seller and agent; never commit keys.
X402_PRICE_API_ENABLED=true
X402_SELLER_ADDRESS=<58-character-algorand-testnet-seller-address>
# Preferred for a local demo. Keep this 25-word secret out of Git.
X402_AGENT_MNEMONIC=<25-word-agent-account-mnemonic>
# Needed only when running scripts/bootstrap_x402_testnet.py to opt the seller
# into TestNet USDC. It is not used by the price API itself.
X402_SELLER_MNEMONIC=<25-word-seller-account-mnemonic>
# Alternatively: X402_AGENT_PRIVATE_KEY=<algorand-agent-private-key>
X402_PRICE_USDC=$0.001
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
ALGOD_TESTNET_URL=https://testnet-api.algonode.cloud
PRICE_API_URL=http://127.0.0.1:4021
